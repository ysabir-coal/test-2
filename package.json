{
  "name": "deployment-validation-service",
  "version": "2.1.0",
  "description": "Deployment validation, setup script download/install and environment checks for CI/CD pipeline",
  "main": "src/index.js",
  "scripts": {
    "build": "tsc --noEmit && echo 'Type check passed'",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/",
    "validate": "node scripts/validate-env.js",
